  },
  {
   "i": 122,
   "en": "A colony's accessibility. The number in parentheses is the maximum out-of-faction shipping capacity, which limits how many units the colony can import, and how much its demand contributes to the global market value.\n\nIn-faction accessibility and shipping capacity are higher.",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
  {
   "i": 123,
   "en": "Colony",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
  {
   "i": 124,
   "en": "Colony name.",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
