   "i": 128,
   "en": "Global market value",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
  {
   "i": 129,
   "en": "How much income the colony is getting from exporting its production of the commodity. A lack of income means that the export activity is underground, most likely due to the commodity being illegal.\n\nIncome also depends on colony stability, so may not directly correlate with market share.",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
  {
   "i": 130,
   "en": "How much the colony's demand contributes to the global market value for the commodity.",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/campaign/ui/marketinfo/cdd/CommodityDetailDialogV2.class"
  },
  {
   "i": 131,
   "en": "Max ",
