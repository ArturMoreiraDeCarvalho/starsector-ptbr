  },
  {
   "i": 132,
   "en": "When the number of ships in your fleet exceeds %s, numerous logistical challenges manifest themselves, increasing the entire fleet's maintenance supply use by %s for every ship above the maximum.",
   "ctx": "starfarer_obf.jar:com/fs/starfarer/coreui/refit/auto/new$1.class"
