  {
   "i": 32,
   "en": "Recent events",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/GensHannanMachinations.class"
  },
  {
   "i": 33,
   "en": "There is no hope of reconciliation, and the gloves are off. There is a possibility of your being brought into active hostility with the League, and of bounty hunters being hired and equipped for the job.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/GensHannanMachinations.class"
  },
  {
   "i": 34,
   "en": "You are not considered trustworthy enough for Gens Hannan to deal with again, and these actions are in the way of setting an example for others.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/GensHannanMachinations.class"
  },
  {
   "i": 35,
   "en": "You may be able to negotiate an end to this by going to Kazeron and speaking with Reynard Hannan.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/GensHannanMachinations.class"
  },
  {
   "i": 36,
