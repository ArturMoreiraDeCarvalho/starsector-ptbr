  },
  {
   "i": 60,
   "en": "The base serves to provide material support to active Pather cells on nearby colonies, enabling them ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/bases/LuddicPathBaseIntel.class"
  },
  {
   "i": 61,
   "en": "This base is known to be providing support to active Pather cells at the following colonies:",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/bases/LuddicPathBaseIntel.class"
  },
  {
   "i": 62,
   "en": "You do not know of any active pather cells this base might be providing support to.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/bases/LuddicPathBaseIntel.class"
  },
  {
   "i": 63,
   "en": "You have destroyed this base.",
