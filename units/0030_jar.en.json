  },
  {
   "i": 22,
   "en": "Fuel production on %s is significantly disrupted",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor.class"
  },
  {
   "i": 23,
   "en": "If the attack is defeated the Diktat will likely abandon further efforts against you, and your ability to export fuel will be improved.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor.class"
  },
  {
   "i": 24,
   "en": "Impending Sindrian Diktat attack",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor.class"
