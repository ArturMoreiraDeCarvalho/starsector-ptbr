   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/RemnantNexusActivityCause.class"
  },
  {
   "i": 19,
   "en": "Sindrian raider fleets have been sighted in your space, attacking trade fleets regardless of their factional allegiance.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor$1.class"
  },
  {
   "i": 20,
   "en": "You've attracted the attention of the Sindrian Diktat.",
