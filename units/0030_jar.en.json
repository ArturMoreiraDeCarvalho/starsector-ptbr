  },
  {
   "i": 38,
   "en": "Active Pather cells on some of your colonies are being supported by a Pather base",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/StandardLuddicPathActivityCause2$1.class"
