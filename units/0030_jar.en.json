   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor.class"
  },
  {
   "i": 28,
   "en": "You've received intel that the Sindrian Diktat is planning an attack to saturation-bombard your fuel production facilities.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/intel/events/SindrianDiktatHostileActivityFactor.class"
  },
  {
