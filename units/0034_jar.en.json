  },
  {
   "i": 107,
   "en": "Rayan Arroyo has agreed to help locate her, in exchange for a favor - selling bad comm fakes to any reasonably highly placed pirate leader, which would serve his ends as part of a disinformation campaign.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/missions/academy/GAProjectZiggurat.class"
  },
  {
   "i": 108,
   "en": "Return to the Galatia Academy and report to Provost Baird",
