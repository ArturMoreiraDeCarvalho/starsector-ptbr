  },
  {
   "i": 109,
   "en": "Return to the Galatia Academy with the scan data and report your findings to Provost ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/missions/academy/GAProjectZiggurat.class"
  },
