  },
  {
   "i": 115,
   "en": "You've learned that the administrator of Culann Starforge will have access to personnel records that may shed light on Kelise's whereabouts.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/missions/academy/GAProjectZiggurat.class"
  },
  {
   "i": 116,
