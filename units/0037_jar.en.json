  },
  {
   "i": 70,
   "en": "The total deployment points of all the ships in your fleet that have the \"Militarized Subsystems\" hullmod.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/skills/BaseSkillEffectDescription$5.class"
  },
  {
   "i": 71,
   "en": "The total number of fighter bays in your fleet. Both empty and filled fighter bays are counted. Built-in fighter bays can be removed from a ship by installing the \"Converted Fighter Bay\" hullmod.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/skills/BaseSkillEffectDescription$6.class"
  },
  {
   "i": 72,
   "en": "And %s other ships with a smaller contribution.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/skills/BaseSkillEffectDescription$7.class"
  },
  {
   "i": 73,
   "en": "Certain skills will have reduced effects if this value exceeds a skill-specific threshold; see the specific skill for details. Mothballed ships are not counted towards the total.",
