   "i": 108,
   "en": "- Click on ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 109,
   "en": "- Move up into the debris field",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 110,
   "en": "- Press %s to engage sustained burn",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 111,
   "en": "- Press %s to open the character tab and consider your options",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 112,
   "en": "- Press %s to open the intel tab, and select the mission",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 113,
   "en": "- Press %s to open the map on the mission target",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 114,
   "en": "- Press %s to quick-save and advance the tutorial",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 115,
   "en": "- Press %s to quick-save, if you like",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 116,
   "en": "- Press %s to start scavenging",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 117,
   "en": "- Press %s twice to turn on the transponder",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 118,
   "en": "- Press and hold %s to move slowly through the asteroid belt",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 119,
   "en": "- Wait for the pirates to approach, then engage and defeat them!",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 120,
   "en": "Please follow the instructions near the bottom of the screen and quicksave to advance the tutorial.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 121,
   "en": "Rogue Miner",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 122,
   "en": "Security Detachment",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/CampaignTutorialScript.class"
  },
  {
   "i": 123,
   "en": "A monthly stipend of %s from the Galatian Academy, for the aid you've recently rendered.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/GalatianAcademyStipend.class"
  },
  {
   "i": 124,
   "en": "Stipend from Galatia Academy",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/GalatianAcademyStipend.class"
  },
  {
   "i": 125,
   "en": "This month's payment was the last.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/GalatianAcademyStipend.class"
  },
  {
   "i": 126,
   "en": "You should continue receiving the stipend for another %s months.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/GalatianAcademyStipend.class"
  },
  {
   "i": 127,
   "en": "Rogue Miner Force",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/RogueMinerMiscFleetManager.class"
  },
  {
   "i": 128,
   "en": "heading to",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/RogueMinerMiscFleetManager.class"
  },
  {
   "i": 129,
   "en": "- Press %s to quick-save",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/SaveNagScript.class"
  },
  {
   "i": 130,
   "en": "An obligation from your past",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/SpacerObligation.class"
  },
  {
   "i": 131,
   "en": "You never talk about it.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/SpacerObligation.class"
  },
  {
   "i": 132,
   "en": "A slow-moving fleet avoids this danger. Press and hold %s to move slowly, until you're through the asteroid belt.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialGoSlowDialogPluginImpl.class"
  },
  {
   "i": 133,
   "en": "If you go through at full speed, there's a chance your fleet may be knocked off course, and some of your ships might even suffer damage from asteroid impacts.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialGoSlowDialogPluginImpl.class"
  },
  {
   "i": 134,
   "en": "The danger is low, however - especially since the belt is thin, and you're only going across it - so you could also get away with just going full speed.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialGoSlowDialogPluginImpl.class"
  },
  {
   "i": 135,
   "en": "You're coming up on an asteroid belt!",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialGoSlowDialogPluginImpl.class"
  },
  {
   "i": 136,
   "en": " as soon as possible.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 137,
   "en": "\"Show on map\"",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 138,
   "en": ". You don't need to do this to travel, ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 139,
   "en": "After dismissing this dialog, press %s to open the intel screen to view the details of the message you've just received.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 140,
   "en": "Let's lay in a course for ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 141,
   "en": "Once you get to Ancyra, open the comm directory to contact ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 142,
   "en": "Select the message and click on the %s button to open the map centered directly on Ancyra. Then, left-click-and-hold on the planet, and select %s from the menu that pops up. Alternatively, you can just right-click on Ancyra.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 143,
   "en": "Shortly after dispatching the pirates, you receive a tight-beam communication from the system's main inhabited world, ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 144,
   "en": "The message is brief and asks you to travel there and contact ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 145,
   "en": "You could also press %s to open the map and locate Ancyra manually.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 146,
   "en": "but it helps keep track of where you're going and how long it'll take to get there.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLayInCourseDialogPluginImpl.class"
  },
  {
   "i": 147,
   "en": " points as you gain experience; these can be used to ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 148,
   "en": "Press %s to open the character tab and consider your options. You don't have to actually spend the points now if you don't want to.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 149,
   "en": "Skill points are used to learn skills. Skills are arranged in four aptitudes - Combat, Leadership, Technology, and Industry. Each aptitude has a number of tiers, you advance to the higher tiers by picking skills from the lower ones.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 150,
   "en": "Skills that affect your piloted ship - all Combat skills, and a few skills in other aptitudes - can be made \"elite\" at the cost of a ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 151,
   "en": "The maximum level you can reach is %s.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 152,
   "en": "You also gain ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 153,
   "en": "You gain %s skill point with each level-up, and an additional point at the start of the campaign.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 154,
   "en": "You've gained a level!",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 155,
   "en": "take exceptional actions - to \"make your own story\", in a way. The tutorial will introduce ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 156,
   "en": "using these a bit later.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialLevelUpDialogPluginImpl.class"
  },
  {
   "i": 157,
   "en": "\n\nAlso: you'll need to re-dock with your transponder turned on to take advantage of Ancyra's facilities.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 158,
   "en": "\"Storage\"",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 159,
   "en": "\"autofit\"",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 160,
   "en": "(Once this conversation is over, press %s to open the refit screen. After selecting a specific ship, you can press %s to %s - pick a desired loadout, and the ship will be automatically refitted to match it, using what weapons are available.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 161,
   "en": "Deliver Report to Jangala",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 162,
   "en": "Deliver Report to Jangala - completed",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 163,
   "en": "In addition, you now have access to local storage at Ancyra, and some weapons and supplies have been placed there. To access it, click on the \"Storage\" button in the trade screen.)",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 164,
   "en": "Stabilize the Jump-points",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionEvent.class"
  },
  {
   "i": 165,
   "en": " and retrieve data",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 166,
   "en": " at Ancyra",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 167,
   "en": " at Ancyra for help with outfitting the recovered ships with weapons.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 168,
   "en": " at Derinkuyu Mining Station ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 169,
   "en": " at Jangala",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 170,
   "en": " at Jangala.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 171,
   "en": " has tasked you with delivering a report ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 172,
   "en": " to deliver the AI core.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 173,
   "en": " to deliver the jump-point data.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 174,
   "en": " with the ships",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 175,
   "en": "Analyzing the jump-point data requires an AI Core.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 176,
   "en": "Approach the probe and salvage it to recover the gamma core.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 177,
   "en": "Bring extra crew to man the recovered ships, and extra supplies to  help restore their combat readiness.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 178,
   "en": "Completed",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 179,
   "en": "Contact must be made with the transponder off as the miners of Derinkuyu have turned pirate and your fleet will be attacked otherwise.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 180,
   "en": "Deliver AI core to ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 181,
   "en": "Deliver data to ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 182,
   "en": "Deliver report to ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 183,
   "en": "Galatia's connection with hyperspace has been restored, and trade fleets are once again able to enter and leave the system.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 184,
   "en": "Go Dark",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 185,
   "en": "Go to Pontus, head out towards the asteroid belt, and then use an %s to locate the probe. ",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  },
  {
   "i": 186,
   "en": "Go to the ship graveyard around Tetra and recover as many ships as possible.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/campaign/tutorial/TutorialMissionIntel.class"
  }
 ]
}