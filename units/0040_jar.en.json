   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 221,
   "en": "Small wpn",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 222,
   "en": "The range bonus is based on the size of the largest ballistic slot, and the increased base range is capped, but still subject to other modifiers.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 223,
   "en": "Utilizes targeting data from the ship's largest ballistic slot to benefit certain weapons, extending the base range of typical ballistic weapons to match similar but larger weapons. Greatly benefits hybrid weapons. Point-defense weapons are unaffected.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 224,
