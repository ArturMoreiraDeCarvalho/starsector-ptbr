  },
  {
   "i": 217,
   "en": "Range cap",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 218,
   "en": "Ship has no ballistic weapon slots",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/BallisticRangefinder.class"
  },
  {
   "i": 219,
   "en": "Since the base range is increased, this modifier - unlike most other flat modifiers - is increased by percentage modifiers from other hullmods and skills.",
