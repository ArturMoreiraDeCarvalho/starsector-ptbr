  },
  {
   "i": 205,
   "en": "Automated ships usually require specialized equipment and expertise to maintain, resulting in a maximum combat readiness penalty of %s. This penalty can be offset by a fleet commander skilled in the use of automated ships.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/Automated.class"
  },
  {
   "i": 206,
   "en": "However, this ship was automated in a fashion that does not require special expertise to maintain. Some of the techniques used are poorly understood, likely dating to an earlier period.",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/Automated.class"
  },
  {
   "i": 207,
   "en": "does not require special expertise",
   "ctx": "starfarer.api.jar:com/fs/starfarer/api/impl/hullmods/Automated.class"
  },
  {
   "i": 208,
   "en": "Affects hybrid weapons (those that can fit into both ballistic and energy slots) of all sizes.",
