  },
  {
   "i": 11,
   "en": "Fragment Swarm|6|50|no damage",
   "ctx": "data/weapons/weapon_data.csv devouring_swarm [customPrimaryHL]"
  },
  {
   "i": 12,
   "en": "100 | energy",
   "ctx": "data/weapons/weapon_data.csv abyssal_glare [customPrimaryHL]"
  },
  {
   "i": 13,
   "en": "Shrouded Vortex | 2000 | energy",
   "ctx": "data/weapons/weapon_data.csv vortex_launcher [customPrimaryHL]"
  },
  {
   "i": 14,
   "en": "Gravitic effects slow and push target off-course. The effect is minor and is most noticeable vs fighters and missiles.",
   "ctx": "data/weapons/weapon_data.csv gravitonbeam [customAncillary]"
  },
  {
   "i": 15,
   "en": "This weapon can not be fired manually and will always launch swarms as soon as it is possible to do so.",
   "ctx": "data/weapons/weapon_data.csv swarm_launcher [customAncillary]"
  },
  {
   "i": 16,
   "en": "A swarm of fragments attacks the target, eating through its armor and dismantling the hull once it's exposed, creating new fragments that return to the launching ship's swarm.",
   "ctx": "data/weapons/weapon_data.csv devouring_swarm [customAncillary]"
  },
  {
   "i": 17,
   "en": "A poorly understood property inherent to space-time inhibits the formation of more than 10 total active rifts for all weapons on the battlefield. This limitation does not apply to the Shrouded Dweller.",
   "ctx": "data/weapons/weapon_data.csv assaying_rift [customAncillary]"
  },
