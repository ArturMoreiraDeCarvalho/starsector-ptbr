{
 "chunk": 50,
 "cat": "data",
 "items": [
  {
   "i": 1,
   "en": "Fires an EMP arc at the target and opens a rift that deals damage in an area around the point of impact. The arc may miss depending on exactly where the weapon is pointing, and can pass over friendly ships.",
   "ctx": "data/weapons/weapon_data.csv rift_lightning [customPrimary]"
  },
  {
   "i": 2,
   "en": "Produces explosions that deal up to 100 points of energy damage to all nearby targets, including the one being hit by the beam.",
   "ctx": "data/weapons/weapon_data.csv abyssal_glare [customPrimary]"
  },
  {
   "i": 3,
   "en": "Fires at the nearest target close to the weapon's current facing. Able to target phased ships. Always hits and targets weapons and engines on ships. Hits on hull or armor cause weapon and engine repairs to take %s longer for %s seconds.",
   "ctx": "data/weapons/weapon_data.csv inimical_emanation [customPrimary]"
  },
  {
   "i": 4,
   "en": "Launches a Shrouded Vortex, which will try to seek out and batter nearby targets and will eventually explode, dealing up to 2000 points of energy damage in an area.",
   "ctx": "data/weapons/weapon_data.csv vortex_launcher [customPrimary]"
  },
  {
   "i": 5,
   "en": "Each shell has a proximity fuse and deals damage over a wide area when it explodes.\r\n\r\nWill target missiles if no other targets are in range.",
   "ctx": "data/weapons/weapon_data.csv heavy_adjudicator [customPrimary]"
  },
  {
   "i": 6,
   "en": "100 | fragmentation",
   "ctx": "data/weapons/weapon_data.csv guardian [customPrimaryHL]"
  },
  {
   "i": 7,
   "en": "Fragment Swarm|50|4",
   "ctx": "data/weapons/weapon_data.csv swarm_launcher [customPrimaryHL]"
  },
  {
   "i": 8,
   "en": "Fragment Swarm|10",
   "ctx": "data/weapons/weapon_data.csv seeker_fragment [customPrimaryHL]"
  },
  {
